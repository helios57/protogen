<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.helios57.protogen</groupId>
        <artifactId>protogen-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>protogen-benchmark</artifactId>
    <name>protogen :: benchmark</name>
    <description>
        JMH benchmarks comparing protogen's generated records against protobuf-java on the same schemas.
        Built by default so it cannot rot; run with `mvn -pl protogen-benchmark -am package -Pbenchmark`
        followed by `java -jar protogen-benchmark/target/benchmarks.jar`.
    </description>

    <properties>
        <!-- test and benchmark harnesses; not artifacts anyone should consume from Central -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <jmh.version>1.37</jmh.version>
        <!-- benchmarks measure hand-written code paths; no need to enforce coverage or run tests here -->
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <dependencies>
        <!-- brings both sides: protogen's records via protogen-it, protoc's classes and protobuf-java -->
        <dependency>
            <groupId>io.github.helios57.protogen</groupId>
            <artifactId>protogen-interop</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          The parent manages protobuf-java at test scope, which is right everywhere else and would
          otherwise force the transitive copy here to test scope too. Benchmarks need it to compile.
        -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Assembling the JMH uber-jar is only needed when actually running benchmarks, so it stays out of
          the default build. `mvn -Pbenchmark package` produces target/benchmarks.jar.
        -->
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <finalName>benchmarks</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>org.openjdk.jmh.Main</mainClass>
                                        </transformer>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
