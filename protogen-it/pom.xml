<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.helios57.protogen</groupId>
        <artifactId>protogen-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>protogen-it</artifactId>
    <name>protogen :: integration-tests</name>
    <description>
        Acceptance test for the project goal: sample .proto files are generated, compiled with an EMPTY
        compile classpath, and verified against protobuf-java (test scope only, never compile scope).
    </description>

    <properties>
        <!-- test and benchmark harnesses; not artifacts anyone should consume from Central -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
          There is deliberately NO compile-scope dependency here. That is the whole point of protogen:
          the generated sources must compile and run against the JDK alone. See PLAN.md invariant I3.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <!-- the wire-format oracle; test scope ONLY -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The runtime validation switch is a static final read at class initialisation, so it can only
              be exercised in a JVM that had the property set before the class loaded. Hence two surefire
              executions: the default one excludes that test, and a second runs only it, with the property.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/ValidationRuntimeSwitchTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>validation-disabled</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/ValidationRuntimeSwitchTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <protogen.validation>false</protogen.validation>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- the interop module reuses the test-side builders, so publish them as a test-jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.helios57.protogen</groupId>
                <artifactId>protogen-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <!-- the defaults: validation on, unknown fields dropped -->
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                    <!--
                      Example configuration for the two opt-ins, and the fixture the tests use to prove
                      they work. A second source root keeps them independent of the default one, since a
                      schema cannot be generated both ways into the same package.
                    -->
                    <!-- AsyncAPI scaffolding: opt-in, written to a throwaway directory, never compiled -->
                    <execution>
                        <id>scaffold-asyncapi</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <protoSourceRoot>${project.basedir}/src/main/asyncapi-proto</protoSourceRoot>
                            <asyncApiSourceRoot>${project.basedir}/src/main/asyncapi</asyncApiSourceRoot>
                            <scaffoldPackage>protogen.it.scaffold</scaffoldPackage>
                            <emitSchemaMetadata>false</emitSchemaMetadata>
                        </configuration>
                    </execution>
                    <!--
                      Spec-first: no proto source root at all, so every model here is generated because the
                      document's payload points at it - and its imports come along.
                    -->
                    <execution>
                        <id>generate-from-asyncapi</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <protoSourceRoot>${project.basedir}/src/main/asyncapi-proto</protoSourceRoot>
                            <asyncApiSourceRoot>${project.basedir}/src/main/asyncapi-spec-first</asyncApiSourceRoot>
                            <scaffoldOutputDirectory>${project.build.directory}/protogen-scaffold-orders</scaffoldOutputDirectory>
                            <scaffoldPackage>protogen.it.specfirst.scaffold</scaffoldPackage>
                            <emitSchemaMetadata>false</emitSchemaMetadata>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-opt-ins</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <protoSourceRoot>${project.basedir}/src/main/proto-optin</protoSourceRoot>
                            <preserveUnknownFields>true</preserveUnknownFields>
                            <emitValidation>false</emitValidation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
