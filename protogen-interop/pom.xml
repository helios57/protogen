<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.helios57.protogen</groupId>
        <artifactId>protogen-parent</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>protogen-interop</artifactId>
    <name>protogen :: interop</name>
    <description>
        Differential tests against the reference implementation. The SAME .proto files are compiled twice -
        once by protogen, once by protoc into protobuf-java classes - and every message is encoded by each
        and decoded by the other. protoc and protobuf-java are confined to this module; nothing here leaks
        into protogen-it, which is the zero-dependency proof.
    </description>

    <properties>
        <!-- test and benchmark harnesses; not artifacts anyone should consume from Central -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- where the rewritten copies of the shared .proto files land -->
        <interop.proto.dir>${project.build.directory}/interop-proto</interop.proto.dir>
        <shared.proto.dir>${project.basedir}/../protogen-it/src/main/proto</shared.proto.dir>
    </properties>

    <dependencies>
        <!-- the protogen-generated records, which themselves have no dependencies at all -->
        <dependency>
            <groupId>io.github.helios57.protogen</groupId>
            <artifactId>protogen-it</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.helios57.protogen</groupId>
            <artifactId>protogen-it</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <!--
              Derive the reference schemas from the shared ones instead of duplicating them, so the two
              sides can never drift apart. Only java_package is rewritten, so protoc's classes do not
              collide with protogen's - everything else, including the well-known types, is compiled from
              the very same text by both sides.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>derive-reference-protos</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy todir="${interop.proto.dir}" overwrite="true">
                                    <fileset dir="${shared.proto.dir}" includes="**/*.proto"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="protogen\.it\.model"
                                                          replace="protogen.it.official"/>
                                            <replaceregex pattern="com\.java\.proto\.model\.proto"
                                                          replace="com.java.proto.official"/>
                                        </tokenfilter>
                                    </filterchain>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf-java.version}:exe:${os.detected.classifier}</protocArtifact>
                    <protoSourceRoot>${interop.proto.dir}</protoSourceRoot>
                    <checkStaleMillis>0</checkStaleMillis>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-reference-schemas</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
